              {
                "data": "#cloud-config\n# Minimal OS prep only.\n# Full runner installation is handled by bootstrap/gh-runners/setup.sh (runs locally).\n\nhostname: gh-runners\nmanage_etc_hosts: true\n\npackage_update: true\npackage_upgrade: false\n\npackages:\n  - curl\n  - ca-certificates\n  - gnupg\n",
