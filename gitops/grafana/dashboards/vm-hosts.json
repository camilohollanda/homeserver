    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Pools in any state other than online. tank is a single disk with no redundancy and replication_factor 1, so a state change here is not a degraded mirror to resilver -- it is the only local copy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 83,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "sum(node_zfs_zpool_state{state!=\"online\"}) or vector(0)",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "ZFS pools not online",
      "type": "stat"
    },
    {
