{
  "uid": "vm-hosts",
  "title": "Host memory and disk",
  "description": "Host memory and disk across the seven node-exporter targets. Pressure sits beside capacity on purpose: a host can be at 40% memory and still be frozen.",
  "tags": [
    "infra"
  ],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoria-metrics"
        },
        "definition": "label_values(node_memory_MemTotal_bytes, host)",
        "query": {
          "query": "label_values(node_memory_MemTotal_bytes, host)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Worst host, ARC excluded, on the same expression the alert uses. Alerts at 90% held for 15 minutes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 80,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max(100 * (1 - (node_memory_MemAvailable_bytes{host=~\"$host\"} + (node_zfs_arc_size{host=~\"$host\"} or 0 * node_memory_MemAvailable_bytes{host=~\"$host\"})) / node_memory_MemTotal_bytes{host=~\"$host\"}))",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Highest memory use",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Worst mounted filesystem across all hosts. /tank is excluded because df on a ZFS dataset reports the dataset, not the pool.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
