      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max(100 * (1 - node_filesystem_avail_bytes{host=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|efivarfs|fuse.*\",mountpoint!~\"/boot.*|/tank.*|/etc/pve|/var/lib/lxcfs\"} / node_filesystem_size_bytes{host=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|efivarfs|fuse.*\",mountpoint!~\"/boot.*|/tank.*|/etc/pve|/var/lib/lxcfs\"}))",
          "range": false,
          "instant": true,
