      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "min(((node_filesystem_avail_bytes{host=~\"$host\", fstype!~\"tmpfs|devtmpfs|overlay|squashfs|efivarfs|fuse.*\", mountpoint!~\"/boot.*|/tank.*|/etc/pve|/var/lib/lxcfs\"} / -deriv(node_filesystem_avail_bytes{host=~\"$host\", fstype!~\"tmpfs|devtmpfs|overlay|squashfs|efivarfs|fuse.*\", mountpoint!~\"/boot.*|/tank.*|/etc/pve|/var/lib/lxcfs\"}[24h]) / 86400) > 0) < 3650)",
