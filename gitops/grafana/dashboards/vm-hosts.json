          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{host=~\"$host\"} + (node_zfs_arc_size{host=~\"$host\"} or 0 * node_memory_MemAvailable_bytes{host=~\"$host\"})) / node_memory_MemTotal_bytes{host=~\"$host\"})",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{host}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "node_memory_MemTotal_bytes{host=~\"$host\"} - node_memory_MemAvailable_bytes{host=~\"$host\"} - (node_zfs_arc_size{host=~\"$host\"} or 0 * node_memory_MemAvailable_bytes{host=~\"$host\"})",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "{{host}} (bytes)"
        }
      ],
      "description": "MemAvailable-based, with the ZFS ARC added back. The ARC is not counted as reclaimable on the hypervisor, which parked proxmox at a permanent 80% while 13.5 GB sat in cache that shrinks the moment anything needs it. This now matches infra-proxmox-mem exactly, so the dashed line at 90% is the alert threshold rather than a decoration. Hosts without ZFS are unaffected."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Share of time tasks were stalled waiting on memory. 'some' means at least one task, 'full' means every task at once -- a host that has stopped rather than slowed. This is what the VM 114 freeze on 2026-08-29 looked like: ten minutes unresponsive with no OOM kill, so neither the memory percentage nor a restart count would have shown it. Anything sustained above zero here is real.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "mappings": [],
          "unit": "percent",
          "decimals": 3
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "100 * rate(node_pressure_memory_waiting_seconds_total{host=~\"$host\"}[5m])",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{host}} some"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "100 * rate(node_pressure_memory_stalled_seconds_total{host=~\"$host\"}[5m])",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "{{host}} full"
        }
      ],
      "title": "Memory pressure (PSI)",
      "type": "timeseries"
    },
