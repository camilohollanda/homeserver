      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "kubelet_volume_stats_capacity_bytes{namespace=\"werify-production\"} - kubelet_volume_stats_available_bytes{namespace=\"werify-production\"}",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{persistentvolumeclaim}} used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "kubelet_volume_stats_capacity_bytes{namespace=\"werify-production\"}",
          "range": true,
