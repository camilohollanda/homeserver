        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "sum by (datname) (pg_stat_activity_count{datname!~\"template.*\", datname!=\"\"}) > 0",
          "range": true,
          "instant": false,
