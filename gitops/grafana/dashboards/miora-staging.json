    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Completed HTTP requests routed to Miora staging, counted from ingress-nginx access logs in Loki over the selected time range. Includes static assets and LiveView long polling. WebSockets count once when the connection closes; messages inside them are not requests. Traffic served or blocked at the Cloudflare edge and direct in-cluster calls are outside this count. Zero means no matching retained logs; totals depend on log collection and retention.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({namespace=\"ingress-nginx\", container=\"controller\", stream=\"stdout\"} |= \"[miora-staging-miora-4000]\" | pattern `<_> - <_> [<_>] \"<_>\" <status> <_> \"<_>\" \"<_>\" <_> <_> [<upstream>] <_>` | __error__=\"\" | upstream=\"miora-staging-miora-4000\" | status=~\"[1-5][0-9]{2}\" [$__range])) or vector(0)",
          "queryType": "instant",
          "refId": "A",
          "legendFormat": "Requests"
        }
      ],
      "title": "HTTP requests in range",
      "type": "stat"
    },
