  "description": "How the disks behave, as opposed to how full they are -- that lives in VM hosts. Pressure first, because a device can look idle and still be what everything is waiting on.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "The share of the last 5 minutes in which at least one task was blocked waiting on I/O. This is the only number here that says the disk is costing somebody time rather than merely being busy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 5
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max(100 * rate(node_pressure_io_waiting_seconds_total{host=~\"$host\"}[5m]))",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Worst I/O pressure",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Highest device utilization: the fraction of wall clock the device spent servicing requests. 100% on a spinning disk means saturated; on an SSD it does not, because SSDs serve requests in parallel.",
