          "expr": "max(rate(node_disk_write_time_seconds_total{host=~\"$host\", device=~\"$device\"}[5m]) / rate(node_disk_writes_completed_total{host=~\"$host\", device=~\"$device\"}[5m]) > 0)",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Worst write latency",
      "type": "stat"
