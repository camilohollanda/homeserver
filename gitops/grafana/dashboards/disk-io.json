          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max(100 * rate(node_disk_io_time_seconds_total{host=~\"$host\", device=~\"$device\"}[5m]))",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Busiest device",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
